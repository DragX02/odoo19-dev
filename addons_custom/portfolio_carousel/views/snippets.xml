                <div class="container py-5">
                    <div class="o_carousel3d"
                         data-c3d-depth="300"
                         data-c3d-autoplay="true"
                         data-c3d-interval="3000">
                        <img src="/web/image/website.s_banner_default_image" alt="1"/>
                        <img src="/web/image/website.s_banner_default_image" alt="2"/>
                        <img src="/web/image/website.s_banner_default_image" alt="3"/>
                        <img src="/web/image/website.s_banner_default_image" alt="4"/>
                        <img src="/web/image/website.s_banner_default_image" alt="5"/>
                        <img src="/web/image/website.s_banner_default_image" alt="6"/>
                    </div>
                </div>
            </section>
        </template>
    </data>
</odoo>