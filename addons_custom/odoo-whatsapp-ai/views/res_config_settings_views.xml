<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_whatsapp_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.whatsapp.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="WhatsApp AI" string="WhatsApp AI" name="whatsapp_ai">
                    <block title="Configuration API Meta">
                        <setting string="Token Meta" help="Jeton d'accès permanent Meta">
                            <field name="whatsapp_meta_token"/>
                        </setting>
                        <setting string="Phone ID" help="ID du numéro de téléphone Meta">
                            <field name="whatsapp_meta_phone_id"/>
                        </setting>
                    </block>
                    <block title="Configuration Intelligence Artificielle">
                        <setting string="Fournisseur LLM">
                            <field name="ai_provider"/>
                        </setting>
                        <setting string="Clé API AI">
                            <field name="ai_api_key" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>