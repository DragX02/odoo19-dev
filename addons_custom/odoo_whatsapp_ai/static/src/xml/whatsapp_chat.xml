<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="whatsapp_chat.ChatWidget">
        <div class="o_whatsapp_chat_container">
            <!-- Zone scrollable des messages -->
            <div class="o_chat_messages" t-ref="messageContainer">
                <t t-if="state.messages.length === 0">
                    <div class="o_chat_empty">
                        <p>Aucun message pour le moment...</p>
                    </div>
                </t>
                <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                    <t t-if="msg">
                        <div t-attf-class="o_whatsapp_message {{ msg.message_type === 'incoming' ? 'o_message_incoming' : 'o_message_outgoing' }}">
                            <div class="o_message_bubble">
                                <t t-if="msg.has_media">
                                    <div class="o_message_media">
                                        <span t-attf-class="badge badge-pill {{ msg.media_type === 'image' ? 'bg-warning' : 'bg-danger' }}">
                                            <t t-if="msg.media_type === 'image'">📷 Image</t>
                                            <t t-elif="msg.media_type === 'pdf'">📄 PDF</t>
                                            <t t-else="">📎 Fichier</t>
                                        </span>
                                    </div>
                                </t>
                                <p class="o_message_text"><t t-esc="msg.body or 'Message vide'"/></p>
                                <t t-if="msg.ai_analysis">
                                    <div class="o_message_analysis alert alert-info alert-link mb-0" role="status">
                                        <small><strong>🤖 IA:</strong> <t t-esc="msg.ai_analysis"/></small>
                                    </div>
                                </t>
                                <div class="o_message_footer">
                                    <span class="o_message_time">
                                        <small>
                                            <t t-if="msg.message_type === 'incoming'">↙</t>
                                            <t t-else="">✓</t>
                                            <t t-if="msg.create_date">
                                                <t t-esc="formatDate(msg.create_date)"/>
                                            </t>
                                        </small>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </div>
            <!-- Barre d'envoi en bas -->
            <div class="o_chat_input_bar">
                <textarea
                    class="o_chat_input"
                    t-model="state.inputText"
                    placeholder="Écrire un message..."
                    rows="1"
                    t-on-keydown="onInputKeydown"
                    t-att-disabled="state.sending"/>
                <button
                    class="btn btn-success o_chat_send_btn"
                    t-on-click="sendMessage"
                    t-att-disabled="state.sending">
                    <t t-if="state.sending">
                        <span class="spinner-border spinner-border-sm me-2"></span>Envoi...
                    </t>
                    <t t-else="">Envoyer ➤</t>
                </button>
            </div>
        </div>
    </t>
</templates>
