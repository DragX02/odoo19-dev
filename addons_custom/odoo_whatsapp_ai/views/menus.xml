<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_whatsapp_ai_contacts" model="ir.actions.act_window">
        <field name="name">Contacts WhatsApp</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('whatsapp_message_ids', '!=', False)]</field>
        <field name="context">{'default_is_ai_generated': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun contact WhatsApp n'a encore été créé.
            </p>
        </field>
    </record>

    <menuitem id="menu_whatsapp_ai_root"
              name="WhatsApp AI"
              web_icon="odoo_whatsapp_ai,static/description/icon.png"
              action="action_whatsapp_ai_contacts"
              sequence="10"/>

    <menuitem id="whatsapp_contacts_menu"
              name="Contacts WhatsApp"
              parent="menu_whatsapp_ai_root"
              action="action_whatsapp_ai_contacts"
              sequence="10"/>
</odoo>