<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_whatsapp_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.whatsapp.ai</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_send_whatsapp_manual" string="Envoyer WhatsApp" type="object" class="oe_highlight"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='phone']" position="after">
                <field name="is_ai_generated" readonly="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Chat WhatsApp">
                    <field name="whatsapp_message_ids" widget="whatsapp_chat" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>