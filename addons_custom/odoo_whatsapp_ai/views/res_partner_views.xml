<odoo>
    <record id="view_partner_form_whatsapp_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.whatsapp.ai</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_whatsapp_manual" string="Envoyer WhatsApp" type="object" class="oe_highlight"/>
            </xpath>
            <xpath expr="//field[@name='phone']" position="after">
                <field name="is_ai_generated" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>