<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_whatsapp_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.whatsapp.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="WhatsApp AI" string="WhatsApp AI" name="odoo_whatsapp_ai">
                    
                    <block title="Evolution API Configuration" name="evolution_api_settings">
                        <setting help="Configurez l'URL de votre serveur Evolution">
                            <field name="evolution_api_url" placeholder="http://localhost:8080"/>
                        </setting>
                        <setting help="Votre clé API secrète (apikey)">
                            <field name="evolution_api_key" password="True"/>
                        </setting>
                        <setting help="Nom de l'instance WhatsApp créée dans Evolution">
                            <field name="evolution_instance_name" placeholder="odoo"/>
                        </setting>
                    </block>

                    <block title="Intelligence Artificielle" name="ai_settings">
                        <setting help="Sélectionnez votre moteur d'IA">
                            <field name="ai_provider"/>
                        </setting>
                        <setting string="Clé API IA" help="Clé pour Gemini ou OpenAI">
                            <field name="ai_api_key" password="True"/>
                        </setting>
                    </block>
                    
                </app>
            </xpath>
        </field>
    </record>
</odoo>