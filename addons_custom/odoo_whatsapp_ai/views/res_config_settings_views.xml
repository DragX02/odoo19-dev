<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_whatsapp_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.whatsapp.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="WhatsApp AI" string="WhatsApp AI" name="odoo_whatsapp_ai">
                    
                    <block title="Evolution API Configuration" name="evolution_api_settings">
                        <setting help="URL de votre serveur Evolution">
                            <field name="evolution_api_url"/>
                        </setting>
                        <setting help="Clé API Evolution">
                            <field name="evolution_api_key" password="True"/>
                        </setting>
                        <setting help="Nom de l'instance WhatsApp">
                            <field name="evolution_instance"/>
                        </setting>
                    </block>

                    <block title="Intelligence Artificielle" name="ai_settings">
                        <setting help="Sélectionnez votre moteur d'IA">
                            <field name="ai_model"/>
                        </setting>
                        <setting string="Clé API Google Gemini" help="Obtenez votre clé gratuite sur https://ai.google.dev/" invisible="ai_model == 'ollama'">
                            <field name="key_ai_api" password="True"/>
                        </setting>
                        <setting string="URL API Ollama" help="URL de votre serveur Ollama local" invisible="ai_model != 'ollama'">
                            <field name="ollama_api_url"/>
                        </setting>
                        <setting string="Modèle Ollama" help="Nom du modèle multimodal à utiliser (ex: llava)" invisible="ai_model != 'ollama'">
                            <field name="ollama_model"/>
                        </setting>
                    </block>
                    
                </app>
            </xpath>
        </field>
    </record>
</odoo>