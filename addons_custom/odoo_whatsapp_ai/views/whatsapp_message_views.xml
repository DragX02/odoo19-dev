<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View for WhatsApp Messages -->
    <record id="whatsapp_message_tree" model="ir.ui.view">
        <field name="name">whatsapp.message.tree</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <list decoration-warning="message_type=='incoming'" decoration-info="message_type=='outgoing'">
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="message_type"/>
                <field name="body"/>
                <field name="has_media"/>
            </list>
        </field>
    </record>

    <!-- Tree View for inline display in partner form -->
    <record id="whatsapp_message_tree_inline" model="ir.ui.view">
        <field name="name">whatsapp.message.tree.inline</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <list decoration-warning="message_type=='incoming'" decoration-info="message_type=='outgoing'" create="false" delete="false">
                <field name="create_date"/>
                <field name="message_type"/>
                <field name="body"/>
                <field name="has_media"/>
            </list>
        </field>
    </record>


    <!-- Form View for WhatsApp Messages -->
    <record id="whatsapp_message_form" model="ir.ui.view">
        <field name="name">whatsapp.message.form</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="create_date"/>
                        </group>
                        <group>
                            <field name="message_type"/>
                            <field name="sender_jid"/>
                        </group>
                    </group>
                    <group>
                        <field name="body" nolabel="1"/>
                    </group>
                    <group>
                        <field name="has_media"/>
                        <field name="media_type" invisible="has_media == False"/>
                        <field name="media_filename" invisible="has_media == False"/>
                    </group>
                    <group string="Analyse IA" invisible="ai_analysis == False or ai_analysis == ''">
                        <field name="ai_analysis" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for WhatsApp Messages -->
    <record id="whatsapp_message_action" model="ir.actions.act_window">
        <field name="name">Messages WhatsApp</field>
        <field name="res_model">whatsapp.message</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem
        id="whatsapp_message_menu"
        name="Messages WhatsApp"
        parent="menu_whatsapp_ai_root"
        action="whatsapp_message_action"
        sequence="20"/>

</odoo>
