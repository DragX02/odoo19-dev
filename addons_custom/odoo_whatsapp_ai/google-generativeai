import google.generativeai as genai
import os
import json
from dotenv import load_dotenv

load_dotenv()

def analyze_card(image_path):
    genai.configure(api_key=os.getenv("AIzaSyCDhRkakO645zqrRQoiLuV1z7f6lHQg9u0"))
    model = genai.GenerativeModel('gemini-1.5-flash')

    # Lecture de l'image
    with open(image_path, "rb") as f:
        img_data = f.read()

    prompt = """
    Analyse cette image de carte de visite. 
    Retourne UNIQUEMENT un JSON :
    {"name": "...", "email": "...", "phone": "...", "company": "...", "job": "..."}
    Si ce n'est pas une carte de visite, retourne {"error": "not_a_card"}
    """

    response = model.generate_content([
        prompt,
        {"mime_type": "image/jpeg", "data": img_data}
    ])

    # Nettoyage du texte pour extraire le JSON pur
    text = response.text.strip().replace('```json', '').replace('```', '')
    return json.loads(text)